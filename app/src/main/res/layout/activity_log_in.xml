<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".log_in"
    android:background="@color/white">

    <ImageView
        android:layout_width="414.6sp"
        android:layout_height="233.1sp"
        android:src="@drawable/background_3"/>

    <ImageView
        android:layout_width="414sp"
        android:layout_height="303.06sp"
        android:src="@drawable/background_4"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:layout_width="10sp"
        android:layout_height="18sp"
        android:src="@drawable/backarrow"
        android:clickable="true"
        android:layout_marginLeft="24.62sp"
        android:layout_marginTop="56.83sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:layout_width="37.72sp"
        android:layout_height="42.97sp"
        android:src="@drawable/carrot_color"
        android:layout_marginTop="77.25sp"
        android:layout_marginLeft="183.08sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    
    <TextView
        android:id="@+id/Login"
        android:layout_width="82sp"
        android:layout_height="wrap_content"
        android:text="Loging"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="25.01sp"
        android:layout_marginTop="233.1sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/text1"
        android:layout_width="233sp"
        android:layout_height="wrap_content"
        android:text="Enter your email and password"
        android:textSize="16sp"
        android:layout_marginTop="15sp"
        android:layout_marginLeft="25.01sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Login"
        android:textColor="@color/grey"/>

    <TextView
        android:id="@+id/text2"
        android:layout_width="233sp"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textSize="16sp"
        android:layout_marginTop="70sp"
        android:layout_marginLeft="25.01sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Login"
        android:textColor="@color/grey"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:layout_width="185sp"
            android:layout_height="29sp"
            android:text="imshuvo97@gmail.com"
            android:textSize="18sp"
            android:layout_marginTop="371.1sp"
            android:layout_marginLeft="28.56sp"/>

        <ImageView
            android:layout_width="364sp"
            android:layout_height="0sp"
            android:src="@drawable/outline"
            android:layout_marginTop="410.65sp"
            android:layout_marginLeft="-190sp"
            android:background="@color/black"/>

    </LinearLayout>

    <TextView
        android:id="@+id/text3"
        android:layout_width="233sp"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textSize="16sp"
        android:layout_marginTop="108.55sp"
        android:layout_marginLeft="25.01sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text2"
        android:textColor="@color/grey"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        
        <TextView
            android:layout_width="185sp"
            android:layout_height="29sp"
            android:text=". . . . . . . ."
            android:textSize="18sp"
            android:layout_marginTop="490.54sp"
            android:layout_marginLeft="28.56sp"/>

        <ImageView
            android:layout_width="364sp"
            android:layout_height="0sp"
            android:src="@drawable/outline"
            android:layout_marginTop="519.2sp"
            android:layout_marginLeft="-190sp"
            android:background="@color/black"/>
        
        <ImageView
            android:layout_width="19.93sp"
            android:layout_height="18.92sp"
            android:src="@drawable/eyebtn"
            android:layout_marginTop="484.69sp"
            android:layout_marginRight="24.83sp"/>

    </LinearLayout>
    
    <TextView
        android:layout_width="125.49sp"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:layout_marginTop="539.2sp"
        android:layout_marginLeft="263.51sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="14sp"
        android:textColor="@color/black"/>
    
    <Button
        android:layout_width="364sp"
        android:layout_height="67sp"
        android:clickable="true"
        android:text="Log In"
        android:background="@drawable/button_layout"
        android:layout_marginTop="583.2sp"
        android:layout_marginLeft="25sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="228.01sp"
        android:layout_height="wrap_content"
        android:text="Don’t have an account? Singup"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginTop="675.2sp"
        android:layout_marginLeft="93dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>