<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Number"
    android:background="@color/white">

    <ImageView
        android:layout_width="414.6dp"
        android:layout_height="233.1dp"
        android:src="@drawable/background_3"/>

    <ImageView
        android:layout_width="414dp"
        android:layout_height="303.06dp"
        android:src="@drawable/background_4"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:layout_width="10dp"
        android:layout_height="18dp"
        android:src="@drawable/backarrow"
        android:clickable="true"
        android:layout_marginLeft="24.62dp"
        android:layout_marginTop="56.83dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:layout_width="278dp"
        android:layout_height="29dp"
        android:text="Enter your mobile number"
        android:textStyle="bold"
        android:textSize="26dp"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="140.02dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:layout_width="112dp"
        android:layout_height="29dp"
        android:text="Mobile Number"
        android:layout_marginTop="196.9dp"
        android:layout_marginLeft="24.49dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="33.97dp"
            android:layout_height="23.7dp"
            android:src="@drawable/bangladesh_flag"
            android:layout_marginTop="236.45dp"
            android:layout_marginLeft="25.07dp"/>

        <TextView
            android:layout_width="42dp"
            android:layout_height="29dp"
            android:text="+880"
            android:layout_marginTop="235.6dp"
            android:layout_marginLeft="12.02dp"/>

        <ImageView
            android:layout_width="364dp"
            android:layout_height="0dp"
            android:src="@drawable/outline"
            android:layout_marginTop="275.17dp"
            android:layout_marginLeft="-89.99dp"
            android:background="@color/outline"/>

    </LinearLayout>

    <ImageView
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:src="@drawable/forwardarrow"
        android:layout_marginLeft="322.07dp"
        android:layout_marginBottom="30.3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>