<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="896dp"
        android:background="@drawable/background_1"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    <ImageView
        android:id="@+id/carrot1"
        android:layout_width="48.47dp"
        android:layout_height="56.36dp"
        android:src="@drawable/carrot"
        android:layout_marginTop="485.26dp"
        android:layout_marginLeft="175dp"/>

    <TextView
        android:id="@+id/Maintext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  Welcome\nto our store"
        android:textColor="@color/white"
        android:textSize="48dp"
        android:textStyle="bold"
        android:layout_marginTop="550.66dp"
        android:layout_marginLeft="80dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="680dp"
        android:text="get your groceries in as fast as one hour"
        android:textColor="@color/white"
        android:textSize="16dp"
        android:layout_marginLeft="65dp"/>

    <Button
        android:id="@+id/StartButton"
        android:layout_width="353dp"
        android:layout_height="67dp"
        android:clickable="true"
        android:text="Get Started"
        android:textColor="@color/white"
        android:backgroundTint="@color/green"
        android:textSize="20dp"
        android:layout_marginTop="730dp"
        android:layout_marginLeft="35dp"/>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>