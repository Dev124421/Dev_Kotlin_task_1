<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="896dp"
        android:background="@drawable/background_1"
        android:orientation="vertical"
        android:gravity="center">

    <ImageView
        android:id="@+id/carrot1"
        android:layout_width="48.47dp"
        android:layout_height="56.36dp"
        android:src="@drawable/carrot"
        android:layout_marginTop="485.26dp"/>

    <TextView
        android:id="@+id/Maintext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  Welcome\nto our store"
        android:textColor="@color/white"
        android:textSize="48dp"
        android:textStyle="bold"
        android:layout_marginTop="35.66px"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19px"
        android:text="get your groceries in as fast as one hour"
        android:textColor="@color/white"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.69" />

    <Button
        android:id="@+id/StartButton"
        android:layout_width="353dp"
        android:layout_height="67dp"
        android:layout_marginTop="40.88px"
        android:layout_marginBottom="90.84px"
        android:clickable="true"
        android:radius="20dp"
        android:text="Get Started"
        android:textColor="@color/white"
        android:backgroundTint="@color/green"
        android:textSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>