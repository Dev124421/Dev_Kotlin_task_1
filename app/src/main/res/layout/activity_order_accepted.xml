<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Order_accepted"
    android:background="@color/white">
    
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/background_3"
        android:layout_marginTop="-120dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:layout_width="269.08dp"
        android:layout_height="240.31dp"
        android:src="@drawable/celebrate"
        android:layout_marginTop="151.7dp"
        android:layout_marginLeft="58.46dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:layout_width="265sp"
        android:layout_height="wrap_content"
        android:text="Your Order has been accepted"
        android:textSize="28sp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="74.5dp"
        android:layout_marginTop="458.67dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="278dp"
        android:layout_height="wrap_content"
        android:text="Your items has been placcd and is on
it’s way to being processed"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/grey"
        android:layout_marginTop="546.67dp"
        android:layout_marginLeft="68dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <Button
        android:id="@+id/Track_button"
        android:layout_width="364dp"
        android:layout_height="67dp"
        android:background="@drawable/button_layout"
        android:clickable="true"
        android:text="Track Order"
        android:layout_marginLeft="24.92dp"
        android:layout_marginTop="723.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back To Home"
        android:layout_marginTop="24.5dp"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/Track_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>