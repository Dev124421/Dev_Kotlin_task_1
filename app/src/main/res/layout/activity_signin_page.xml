<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".signin_page">

    <ImageView
        android:id="@+id/topimage"
        android:layout_width="0dp"
        android:layout_height="330dp"
        android:scaleType="centerCrop"
        android:src="@drawable/background_2"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="423.63dp"
        android:layout_marginEnd="24dp"
        android:text="Get your groceries\nwith nectar"
        android:textColor="#181725"
        android:textSize="26sp"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/phoneInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="517.24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivFlag"
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:scaleType="fitXY"
            android:src="@drawable/bangladesh_flag"
            android:contentDescription="Country Code" />

        <TextView
            android:id="@+id/tvCountryCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="+880"
            android:textColor="#181725"
            android:textSize="18sp"
            android:textStyle="normal" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"  />

    </LinearLayout>

    <View
        android:id="@+id/inputDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E2E2E2"
        app:layout_constraintTop_toBottomOf="@id/phoneInputContainer"
        app:layout_constraintStart_toStartOf="@id/phoneInputContainer"
        app:layout_constraintEnd_toEndOf="@id/phoneInputContainer" />

    <TextView
        android:id="@+id/socialtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="596.79dp"
        android:text="Or connect with social media"
        android:textColor="#828282"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/googlebutton"
        android:layout_width="364dp"
        android:layout_height="67dp"
        android:text="Continue with Google"
        android:layout_marginTop="651.58dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clickable="true"
        android:backgroundTint="@color/google_blue"/>

    <Button
        android:id="@+id/facebookbutton"
        android:layout_width="364dp"
        android:layout_height="67dp"
        android:text="Continue with Facebook"
        android:layout_marginTop="738.58dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="@color/facebook_blue"
        android:clickable="true"/>

</androidx.constraintlayout.widget.ConstraintLayout>